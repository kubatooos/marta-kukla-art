---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
---

<Layout title="Home">
  <Hero />

  <section class="border-t border-graphite-700 px-6 py-24 text-center md:px-12">
    <p class="mx-auto max-w-2xl font-serif text-2xl font-extralight italic leading-relaxed text-ivory-muted md:text-3xl">
      <span class="pl">Każdy obraz zaczyna się od jednej decyzji — gdzie pierwszy raz dotknąć płótna.</span>
      <span class="en">Every painting begins with one decision — where to first touch the canvas.</span>
    </p>
    <a
      href="/o-mnie"
      class="brush-underline mt-10 inline-block font-sans text-xs uppercase tracking-widest2 text-ivory hover:drop-shadow-neon-pink"
      style="--accent:#ff007f"
    >
      <span class="pl">Poznaj artystkę →</span>
      <span class="en">Meet the artist →</span>
    </a>
  </section>
</Layout>
