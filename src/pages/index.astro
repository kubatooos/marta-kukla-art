---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import WorkCard from '../components/WorkCard.astro';
import { works } from '../data/works';

const featured = works.slice(0, 3);
---

<Layout title="Home">
  <Hero />

  {featured.length > 0 && (
    <section class="mx-auto max-w-6xl px-6 py-24 md:px-12 md:py-32">
      <div class="mb-16 flex flex-col items-start gap-4 md:flex-row md:items-end md:justify-between">
        <h2 class="font-serif text-4xl font-extralight text-ivory md:text-5xl">
          <span class="pl">Wybrane prace</span>
          <span class="en">Selected works</span>
        </h2>
        <a
          href="/katalog"
          class="brush-underline font-sans text-xs uppercase tracking-widest2 text-ivory-muted hover:drop-shadow-neon-turquoise"
          style="--accent:#00f5d4"
        >
          <span class="pl">Cały katalog →</span>
          <span class="en">Full catalogue →</span>
        </a>
      </div>

      <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
        {featured.map((work) => <WorkCard work={work} />)}
      </div>
    </section>
  )}

  <section class="border-t border-graphite-700 px-6 py-24 text-center md:px-12">
    <p class="mx-auto max-w-2xl font-serif text-2xl font-extralight italic leading-relaxed text-ivory-muted md:text-3xl">
      <span class="pl">Każdy obraz zaczyna się od jednej decyzji — gdzie pierwszy raz dotknąć płótna.</span>
      <span class="en">Every painting begins with one decision — where to first touch the canvas.</span>
    </p>
    <a
      href="/o-mnie"
      class="brush-underline mt-10 inline-block font-sans text-xs uppercase tracking-widest2 text-ivory hover:drop-shadow-neon-pink"
      style="--accent:#ff007f"
    >
      <span class="pl">Poznaj artystkę →</span>
      <span class="en">Meet the artist →</span>
    </a>
  </section>
</Layout>
