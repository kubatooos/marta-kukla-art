---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Kontakt">
  <section class="mx-auto flex min-h-[70vh] max-w-3xl flex-col items-start justify-center px-6 py-32 md:px-12">
    <p class="mb-4 font-sans text-[11px] uppercase tracking-widest2 text-ivory-muted">
      <span class="pl">Napisz</span><span class="en">Get in touch</span>
    </p>
    <h1 class="mb-8 font-serif text-5xl font-extralight text-ivory md:text-6xl">
      <span class="pl">Kontakt</span><span class="en">Contact</span>
    </h1>

    <p class="mb-12 max-w-xl font-serif text-xl font-light leading-relaxed text-ivory-muted">
      <span class="pl">
        Pytania o konkretny obraz, dostępność lub zamówienie indywidualne — pisz śmiało,
        odpowiadam zwykle w ciągu dwóch dni.
      </span>
      <span class="en">
        Questions about a specific piece, availability, or a commission — write freely,
        I usually reply within two days.
      </span>
    </p>

    <div class="flex flex-col gap-6">
      <a
        href="mailto:kontakt@martakukla.pl"
        class="brush-underline font-serif text-3xl font-light text-ivory hover:drop-shadow-neon-pink md:text-4xl"
        style="--accent:#ff007f"
      >
        kontakt@martakukla.pl
      </a>
      <a
        href="tel:+48000000000"
        class="brush-underline font-serif text-3xl font-light text-ivory hover:drop-shadow-neon-turquoise md:text-4xl"
        style="--accent:#00f5d4"
      >
        +48 000 000 000
      </a>
    </div>

    <p class="mt-16 font-sans text-[11px] uppercase tracking-widest2 text-ivory-muted">
      <span class="pl">Pracownia: Wrocław, Polska</span>
      <span class="en">Studio: Wrocław, Poland</span>
    </p>
  </section>
</Layout>
