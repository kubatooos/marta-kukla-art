---

<section class="relative flex h-[100svh] min-h-[560px] w-full items-center justify-center overflow-hidden bg-graphite-950">
  <img
    src="/images/hero-brush.jpg"
    alt=""
    class="absolute inset-0 h-full w-full object-cover"
  />
  <div class="absolute inset-0 bg-gradient-to-b from-graphite-950/70 via-graphite-950/55 to-graphite-950"></div>

  <div class="relative z-10 flex flex-col items-center px-6 text-center">
    <p class="mb-6 font-sans text-[11px] uppercase tracking-widest2 text-ivory-muted">
      <span class="pl">Malarstwo</span><span class="en">Painting</span>
    </p>
    <h1 class="font-serif text-6xl font-extralight leading-[0.95] tracking-wide text-ivory sm:text-8xl md:text-9xl">
      MARTA<br />KUKLA
    </h1>
    <p class="mt-8 font-serif text-xl italic text-ivory-muted sm:text-2xl">
      <span class="pl">Witaj w moim świecie sztuki</span><span class="en">Welcome to my World of art</span>
    </p>

    <a
      href="/katalog"
      class="brush-underline mt-14 font-sans text-xs uppercase tracking-widest2 text-ivory hover:drop-shadow-neon-pink"
      style="--accent:#ff007f"
    >
      <span class="pl">Zobacz katalog prac →</span>
      <span class="en">View the catalogue →</span>
    </a>
  </div>
</section>
